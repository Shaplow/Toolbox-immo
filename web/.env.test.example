# Configuration env pour la base de données de test (toolbox_test).
# Copier en .env.test (gitignored) et adapter si nécessaire.

# Postgres credentials (par défaut : valeurs du Docker compose dev)
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# DATABASE_URL pointant vers la DB de test
# Recalculé automatiquement par setup-test-db.ts à partir des variables ci-dessus,
# mais utilisé par Vitest et Playwright pour ouvrir le client Prisma.
DATABASE_URL=postgresql://toolbox:toolbox@localhost:5433/toolbox_test

# NextAuth — secret arbitraire de test (ne jamais utiliser en prod)
NEXTAUTH_SECRET=test-secret-please-do-not-use-in-production
NEXTAUTH_URL=http://localhost:3000
