FROM node:20-slim

# Dépendances système pour Puppeteer (Chromium bundled — nécessite glibc, pas musl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 libpango-1.0-0 libcairo2 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Installer les dépendances d'abord (layer cache)
COPY package.json package-lock.json* ./
# prisma/schema.prisma requis par le postinstall (prisma generate)
COPY prisma ./prisma
RUN npm install --legacy-peer-deps

# Copier le reste (surchargé par le volume en dev)
COPY . .

EXPOSE 3000

# Dev server avec hot-reload
CMD ["npm", "run", "dev"]
