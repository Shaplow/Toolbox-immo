{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:backup": "dotenv -e .env.local -- tsx scripts/db-backup.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:setup": "prisma db push && prisma generate",
    "db:backfill-plans": "dotenv -e .env.local -- tsx scripts/backfill-account-plans.ts",
    "db:import": "npx tsx scripts/import-postgres.mjs",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "test:db:reset": "tsx scripts/setup-test-db.ts --reset",
    "test:db:seed": "tsx scripts/seed-test-db.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "puppeteer": "^24.37.5",
    "qrcode": "^1.5.4",
    "re-resizable": "^6.10.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
