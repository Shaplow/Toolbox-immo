generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                @id @default(cuid())
  username                 String?               @unique
  email                    String?               @unique
  passwordHash             String
  name                     String
  role                     String                @default("USER")
  /// JSON array of tool strings — ex: ["templates","captions"]
  permissions              String                @default("[]")
  createdAt                DateTime              @default(now())
  templates                Template[]
  listings                 Listing[]
  accesses                 TemplateAccess[]
  captionJobs              CaptionJob[]
  captionPresets           CaptionPreset[]
  captionPresetAccesses    CaptionPresetAccess[]
  transcriptionJobs        TranscriptionJob[]
  descriptionJobs          DescriptionJob[]
  coverFramePacks          CoverFramePack[]
  defaultMonteurForRecipes ContentRecipe[]       @relation("RecipeDefaultMonteur")
  defaultCmForRecipes      ContentRecipe[]       @relation("RecipeDefaultCm")
  uploadedVersions         PublicationVersion[]  @relation("VersionUploader")
  assignedAsMonteur        PublicationSlot[]     @relation("SlotMonteur")
  assignedAsCm             PublicationSlot[]     @relation("SlotCm")
  publicationComments      PublicationComment[]  @relation("PublicationCommentAuthor")
  publicationActivities    PublicationActivity[] @relation("PublicationActivityActor")
}

model CaptionJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  inputUrl    String?
  inputKey    String? // clé R2 de la vidéo source (supprimée après complétion)
  outputUrl   String?
  outputKey   String? // clé R2 de l'output
  runpodJobId String?  @unique // ID job RunPod pour polling
  errorMsg    String? // message d'erreur lisible
  config      String   @default("{}") // JSON sérialisé
  srtContent  String? // Contenu SRT utilisé pour la génération (pour regénérer)
  srtFilename String? // Nom du fichier SRT/JSON d'origine (pour détecter format)
  previewMode Boolean  @default(false) // true = preview 6s, false = rendu complet
  presetId    String? // ID du preset utilisé
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Preset de sous-titres sauvegardé (config complète + polices)
model CaptionPreset {
  id        String                @id @default(cuid())
  name      String
  /// null = preset global/builtin (visible par tous), sinon appartient à l'user
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBuiltin Boolean               @default(false)
  /// ConfigState JSON sérialisé (base, highlight, layout, effects, animation...)
  config    String                @default("{}")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  accesses  CaptionPresetAccess[]
}

model CaptionPresetAccess {
  id        String        @id @default(cuid())
  userId    String
  presetId  String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset    CaptionPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([userId, presetId])
}

model CaptionPrompt {
  id                     String   @id @default(cuid())
  name                   String
  prompt                 String
  autoHighlightEnabled   Boolean  @default(false)
  autoHighlightMode      String   @default("highlight1")
  autoHighlightPlacement String   @default("after")
  autoHighlightPrompt    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Template {
  id               String              @id @default(cuid())
  name             String
  client           String              @default("")
  formats          String              @default("[]") // JSON array ["A3_LANDSCAPE", "A4_PORTRAIT"]
  jsonData         String              @default("{}") // TemplateJSON sérialisé
  /// Type de contenu éditorial : "RPI" | "RVA4" | "RVA5" | "RTIPS" | "RPOD" | "REACT" | "RQR" | "" (vide = non défini)
  contentType      String              @default("")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  listings         Listing[]
  renders          Render[]
  coverFramePacks  CoverFramePack[]
  accesses         TemplateAccess[]
  publicationSlots PublicationSlot[]
  scheduleRules    OfferScheduleRule[]
  contentRecipes   ContentRecipe[]
}

model FontAsset {
  id           String   @id @default(cuid())
  family       String
  weight       Int      @default(400)
  fontStyle    String   @default("normal")
  url          String
  storageKey   String?
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([family, weight, fontStyle])
}

model TemplateAccess {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model Listing {
  id         String    @id @default(cuid())
  templateId String?
  jsonData   String    @default("{}") // ListingData sérialisé
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  renders    Render[]
}

model Render {
  id                String            @id @default(cuid())
  listingId         String
  templateId        String?
  status            RenderStatus      @default(PENDING)
  /// Pipeline utilisé: image | video-local | video-runpod
  pipeline          String?
  /// Étape détaillée pour le suivi UI / debug
  stage             String?
  /// Détail court de progression (humain)
  statusDetail      String?
  /// Progression approximative 0..1 pour l'UI
  progress          Float?
  pngUrl            String?
  /// URL vidéo finale (renders avec un VideoBlock — pipeline RunPod)
  videoUrl          String?
  /// ID du job RunPod (pour polling — null si pipeline Node.js)
  runpodJobId       String?           @unique
  errorMsg          String?
  /// JSON map des assets de bibliothèque utilisés pour ce render
  /// { videoAssets: { blockId: assetId }, audioAssetId?: string, dataEntryId?: string, setSequencedLibraryIds?: string[] }
  usedAssets        String            @default("{}")
  /// JSON map { [slotId]: effectiveDurationSeconds } pour les renders sequence.
  /// Renseigné par render-engine (local ou RunPod) après la composition. Utilisé pour
  /// résoudre les bornes temporelles des slots exclus du sous-titrage et de la cover.
  slotDurations     String?
  /// Compte Instagram pour lequel ce render a été généré (optionnel)
  accountId         String?
  account           InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Slot de calendrier auquel ce render est rattaché (optionnel)
  publicationSlotId String?           @unique
  publicationSlot   PublicationSlot?  @relation(fields: [publicationSlotId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  lastHeartbeatAt   DateTime?
  listing           Listing           @relation(fields: [listingId], references: [id])
  template          Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Job de transcription déclenché automatiquement après ce render (si captionAutoConfig activé)
  transcriptionJob  TranscriptionJob?
  /// Pack de frames cover préparé automatiquement après ce render (si coverAutoConfig activé)
  coverFramePack    CoverFramePack?
}

enum RenderStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model TranscriptionJob {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String           @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  inputKey          String? // clé R2 du fichier audio source
  inputFilename     String? // nom original pour l'affichage
  model             String           @default("turbo") // ex: "turbo", "large-v3"
  language          String           @default("fr")
  enableDiarization Boolean          @default(false) // demande de segmentation par speaker
  hasDiarization    Boolean          @default(false) // résultat effectif (false si pas de HF_TOKEN)
  runpodJobId       String?          @unique // ID job RunPod pour polling
  outputJsonKey     String? // clé R2 du JSON segments brut (persistant)
  segmentCount      Int?
  duration          Float? // durée audio en secondes
  errorMsg          String?
  /// Render à l'origine de ce job (si déclenché automatiquement via captionAutoConfig)
  renderId          String?          @unique
  render            Render?          @relation(fields: [renderId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  descriptionJobs   DescriptionJob[]
}

model CoverFramePack {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  renderId            String                @unique
  render              Render                @relation(fields: [renderId], references: [id], onDelete: Cascade)
  templateId          String?
  template            Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status              String                @default("QUEUED") // QUEUED | PROCESSING | READY | SELECTED | FAILED
  sourceVideoUrl      String?
  duration            Float?
  frameCount          Int                   @default(36)
  /// JSON string[] — timestamps déjà proposés, pour les tirages suivants.
  usedTimestamps      String                @default("[]")
  /// JSON — snapshot de la config cover au moment de la génération.
  config              String                @default("{}")
  /// JSON string[] — groupes de blocs utilisés comme overlay texte cover.
  overlayGroupIds     String                @default("[]")
  overlayOffsetX      Float                 @default(0)
  overlayOffsetY      Float                 @default(0)
  selectedCandidateId String?
  finalCoverUrl       String?
  finalCoverKey       String?
  errorMsg            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  candidates          CoverFrameCandidate[]

  @@index([userId, status])
  @@index([templateId])
}

model CoverFrameCandidate {
  id        String         @id @default(cuid())
  packId    String
  pack      CoverFramePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  timestamp Float
  imageUrl  String
  imageKey  String?
  createdAt DateTime       @default(now())

  @@index([packId])
}

/// Prompt personnalisé pour la génération de descriptions (géré par les admins)
model DescriptionPrompt {
  id        String           @id @default(cuid())
  name      String
  prompt    String // Instructions pour le LLM
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  jobs      DescriptionJob[]
}

/// Résultat d'une génération de description à partir d'un SRT/JSON
model DescriptionJob {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String             @default("COMPLETED") // COMPLETED | FAILED
  /// "upload" = fichier uploadé, "transcription" = TranscriptionJob existant
  inputType       String             @default("upload")
  inputFilename   String? // nom du fichier SRT/JSON original
  transcriptionId String?
  transcription   TranscriptionJob?  @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
  promptId        String?
  prompt          DescriptionPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  /// Snapshot du texte du prompt au moment de la génération
  promptSnapshot  String?
  personalization String? // Texte libre injecté dans le prompt
  model           String             @default("claude") // "claude" | "gpt"
  result          String? // Texte généré
  errorMsg        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// ─── Content Library ─────────────────────────────────────────────────────────

/// Bibliothèque de médias (vidéos rush ou musiques). Gérée par les admins.
model MediaLibrary {
  id             String                 @id @default(cuid())
  name           String
  /// "video" | "audio"
  type           String
  /// JSON string[] — tags de type template : ["RPI","RTIPS","RPOD"]
  tags           String                 @default("[]")
  description    String?
  /// JSON string[] — ordre explicite des setTags pour la rotation : ["tenue1-set1","tenue2-set1","tenue1-set2"]
  setSequence    String                 @default("[]")
  /// JSON Record<string,string> — setTag → famille : {"tenue1-set1":"tenue1","tenue1-set2":"tenue1","tenue2-set1":"tenue2"}
  /// En mode auto, tous les setTags d'une même famille sont exclus ensemble après utilisation.
  /// Portée de la rotation :
  /// - "per_account" (défaut) : curseur et usages séparés par compte. Chaque négociateur avance
  ///   dans la bibliothèque indépendamment des autres.
  /// - "shared" : un seul curseur partagé entre tous les comptes. Tous les comptes voient le
  ///   même contenu à chaque génération (utile pour une bibliothèque commune).
  rotationScope  String                 @default("per_account")
  /// JSON { key: string; label: string; type: "text" | "number" | "url" }[] — champs de
  /// métadonnées structurées pouvant être remplis sur chaque asset de cette bibliothèque.
  metadataSchema String                 @default("[]")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  assets         MediaAsset[]
  accountCursors AccountLibraryCursor[]
  autocutBatches MediaAutocutBatch[]
  autocutJobs    MediaAutocutJob[]
  contentRecipes ContentRecipe[]
}

/// Un fichier média dans une bibliothèque (stocké sur R2).
model MediaAsset {
  id          String             @id @default(cuid())
  libraryId   String
  library     MediaLibrary       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  filename    String
  r2Key       String             @unique
  url         String
  /// "video/mp4" | "audio/mpeg" etc.
  mimeType    String
  /// Durée en secondes (remplie au probe après upload)
  duration    Float?
  /// JSON string[] — tags métier associés au fichier : ["RPI","RTIPS","RPOD"]
  tags        String             @default("[]")
  /// Clé de groupement pour les paires intro/outro (même lieu, même tenue).
  /// Les assets partageant le même setTag sont sélectionnés ensemble lors d'une résolution theme_sequence.
  setTag      String?
  /// Catégorie de rotation : stockée par asset (permet le même nom de set dans plusieurs catégories).
  /// L'unité de rotation est le couple (category, setTag). Null = pas de catégorie assignée.
  category    String?
  /// Nombre de fois utilisé dans une génération (agrégat global)
  usageCount  Int                @default(0)
  /// Dernier timestamp d'utilisation global (agrégat de tous comptes)
  lastUsedAt  DateTime?
  /// Désactivé de la rotation : reste dans la bibliothèque mais jamais suggéré
  disabled    Boolean            @default(false)
  /// JSON Record<string, string | number | null> — valeurs de métadonnées structurées
  /// définies par le MediaLibrary.metadataSchema de la bibliothèque parente.
  metadata    String             @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  editJobs    MediaEditJob[]
  /// Entrées de contrôle d'accès (0 entrées = global/tous comptes)
  accesses    MediaAssetAccess[]
  /// Suivi d'utilisation par compte
  usages      MediaAssetUsage[]
  autocutJobs MediaAutocutJob[]
}

/// Job d'édition d'un rush (trim, audio fix). Traitement RunPod, destructif (écrase l'original).
model MediaEditJob {
  id         String           @id @default(cuid())
  assetId    String
  asset      MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// "pending" | "processing" | "done" | "failed"
  status     String           @default("pending")
  /// JSON MediaEditParams : { trimStart?, trimEnd?, mixToMono?, normalize?, gainDb? }
  params     String           @default("{}")
  runpodId   String?          @unique
  errorMsg   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  autocutJob MediaAutocutJob?

  /// Accélère le filtre status actif sur les includes (/assets et /assets/active-jobs)
  @@index([assetId, status])
}

/// Pack RunPod d'analyse autocut : un job RunPod traite N assets en série (Whisper chargé une seule fois).
model MediaAutocutBatch {
  id         String            @id @default(cuid())
  libraryId  String
  library    MediaLibrary      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// "pending" | "processing" | "done" | "partial" | "failed"
  status     String            @default("pending")
  totalCount Int               @default(0)
  doneCount  Int               @default(0)
  failCount  Int               @default(0)
  runpodId   String?           @unique
  errorMsg   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  jobs       MediaAutocutJob[]
}

/// Analyse Whisper d'un seul asset — propose des timings de coupe.
model MediaAutocutJob {
  id             String             @id @default(cuid())
  assetId        String
  asset          MediaAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  libraryId      String
  library        MediaLibrary       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          MediaAutocutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// "pending" | "processing" | "done" | "failed"
  status         String             @default("pending")
  /// Détecté par Whisper (en secondes, avec padding)
  proposedStart  Float?
  proposedEnd    Float?
  /// JSON [{ text, start, end }] — segments niveau phrase uniquement (pas les mots)
  transcriptJson String?
  language       String?
  /// "pending_review" | "accepted" | "skipped" | "applied"
  reviewStatus   String             @default("pending_review")
  /// Timings confirmés par l'admin (peut différer de proposed si ajustement manuel)
  confirmedStart Float?
  confirmedEnd   Float?
  /// FK vers le MediaEditJob créé lors de l'apply
  editJobId      String?            @unique
  editJob        MediaEditJob?      @relation(fields: [editJobId], references: [id], onDelete: SetNull)
  errorMsg       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  /// Accélère le filtre actif dans autocut-packs (status in [pending, processing])
  @@index([assetId, status])
  /// Accélère autocut-queue (where libraryId + orderBy reviewStatus)
  @@index([libraryId, reviewStatus])
}

/// Bibliothèque de données texte, rattachée à un type de template (RPI, RTIPS…).
model DataLibrary {
  id           String         @id @default(cuid())
  name         String
  /// Identifiant métier du type : "RPI" | "RTIPS" | "RPOD" | etc.
  templateType String
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  campaigns    DataCampaign[]
}

/// Cycle de données (ex: "RPI Q1 2026"). Une fiche active à la fois par library.
model DataCampaign {
  id           String      @id @default(cuid())
  libraryId    String
  library      DataLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Nom du cycle, ex: "RPI Q1 2026"
  name         String
  isActive     Boolean     @default(true)
  /// Date du dernier reset de cycle (tous les usedInCycle remis à false)
  cycleResetAt DateTime?
  ///
  /// Politique d'utilisation des fiches :
  /// - "cycle"             : tour à tour global. usedInCycle=true après usage, reset manuel.
  /// - "cycle_per_account" : tour à tour par compte. Chaque compte consomme ses fiches
  ///                         indépendamment ; quand tout est utilisé → recommence.
  /// - "once_per_account"  : max 1 usage par compte. Une fois toutes les fiches utilisées
  ///                         par un compte, plus rien n'est suggéré.
  /// - "once_global"       : max 1 usage au total tous comptes confondus.
  /// - "unlimited"         : pas de contrainte, toujours least_used.
  usagePolicy  String      @default("cycle")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entries      DataEntry[]
}

/// Une fiche de données texte (une ligne de l'Excel d'origine).
model DataEntry {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    DataCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// JSON — champs libres selon le templateType (ex: {quartier, prix_m2, evo_5ans_pct})
  fields      String            @default("{}")
  /// Identifiant de set (regroupe les fiches d'un même thème/lot).
  setTag      String?
  /// Famille de sets — utilisé pour l'exclusion consécutive en rotation auto.
  category    String?
  usageCount  Int               @default(0)
  lastUsedAt  DateTime?
  /// Remis à false au reset de cycle. Permet la règle "pas encore utilisé ce cycle".
  usedInCycle Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  accesses    DataEntryAccess[]
  usages      DataEntryUsage[]
}

/// Compte Instagram client géré par l'admin (pas de login propre dans l'app).
model InstagramAccount {
  id               String                 @id @default(cuid())
  name             String
  /// Handle Instagram sans le @
  handle           String                 @unique
  /// "ESSENTIEL" | "CONFIRME" | "CEO"
  offre            String
  clientId         String?
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  cursors          AccountLibraryCursor[]
  renders          Render[]
  publicationSlots PublicationSlot[]
  assetAccesses    MediaAssetAccess[]
  assetUsages      MediaAssetUsage[]
  entryAccesses    DataEntryAccess[]
  entryUsages      DataEntryUsage[]
  accountPlans     AccountPlan[]

  @@index([clientId])
}

/// Contrôle d'accès d'une fiche de données par compte.
/// 0 entrée pour une fiche = accès global. 1+ entrées = restreint aux comptes listés.
model DataEntryAccess {
  entryId   String
  accountId String
  entry     DataEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entryId, accountId])
}

/// Suivi d'utilisation d'une fiche de données par compte.
/// Permet la rotation indépendante pour chaque négociateur partageant une bibliothèque de données.
model DataEntryUsage {
  entryId    String
  accountId  String
  lastUsedAt DateTime?
  usageCount Int              @default(0)
  entry      DataEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entryId, accountId])
}

/// Contrôle d'accès d'un asset par compte : si au moins une entrée existe pour cet asset,
/// seuls les comptes listés peuvent utiliser cet asset. 0 entrée = accès global.
model MediaAssetAccess {
  assetId   String
  accountId String
  asset     MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([assetId, accountId])
}

/// Suivi d'utilisation par compte : compteur et date d'utilisation isolés par compte.
/// Permet la rotation indépendante pour chaque négociateur partageant une bibliothèque.
model MediaAssetUsage {
  assetId    String
  accountId  String
  lastUsedAt DateTime?
  usageCount Int              @default(0)
  asset      MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([assetId, accountId])
}

/// Curseur de position dans la séquence de thèmes d'une bibliothèque, par compte Instagram.
/// Clé composite unique (accountId, libraryId) — chaque compte avance indépendamment.
model AccountLibraryCursor {
  id               String           @id @default(cuid())
  accountId        String
  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  libraryId        String
  library          MediaLibrary     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Index courant dans MediaLibrary.setSequence (mode override uniquement)
  cursor           Int              @default(0)
  /// Dernier setTag utilisé — permet d'éviter deux fois le même groupe de suite (mode auto et override)
  lastUsedSetTag   String?
  /// Dernière catégorie utilisée — pour l'exclusion famille en mode auto (deux sets de même catégorie ne se suivent pas)
  lastUsedCategory String?
  lastAdvancedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([accountId, libraryId])
}

// ─── Offres commerciales ─────────────────────────────────────────────────────

/// Offre commerciale — liste gérée depuis l'admin.
/// Le champ name (ex: "ESSENTIEL") est utilisé comme clé dans les comptes Instagram et les règles de planification.
model Offer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ─── Calendrier de publication ───────────────────────────────────────────────

/// Règle de planification par offre : 1 règle = 1 template, 1 jour, 1 heure.
/// Exemple : offre=ESSENTIEL, dayOfWeek=1 (Lundi), publishTime="19:00", templateId="cld..."
model OfferScheduleRule {
  id           String    @id @default(cuid())
  /// "ESSENTIEL" | "CONFIRME" | "CEO" | "COMPTE_AGENCE"
  offre        String
  /// Jour ISO : 1=Lundi, 2=Mardi … 7=Dimanche
  dayOfWeek    Int
  /// Heure cible au format "HH:MM" (ex: "19:00")
  publishTime  String
  /// Type de contenu — déduit automatiquement de Template.contentType lors de la création
  contentType  String
  /// Template lié (source du type de contenu)
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  /// Marqué comme obsolète (remplacé par AccountPlan + ContentRecipe)
  deprecated   Boolean   @default(false)
  deprecatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([offre, dayOfWeek, publishTime, contentType])
  @@index([offre])
  @@index([dayOfWeek])
  @@index([templateId])
}

/// Slot réel dans le calendrier opérationnel pour un compte Instagram donné.
model PublicationSlot {
  id                String                @id @default(cuid())
  accountId         String
  account           InstagramAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Date et heure cible de publication (UTC)
  scheduledAt       DateTime
  /// Type de contenu : "RPI" | "RVA4" | "RVA5" | "RTIPS" | "RPOD" | "REACT" | "RQR"
  contentType       String
  /// "TO_DO" | "IN_PROGRESS" | "READY" | "CHECKING" | "DONE"
  status            String                @default("TO_DO")
  title             String?
  /// Texte de la légende Instagram (pour la CM)
  caption           String?
  /// Champs libres saisis par l'utilisateur (JSON Record<string, string>)
  /// ex: {"adresse":"12 rue ...","prix":"350 000 €","propriétaire":"Dupont"}
  fields            String                @default("{}")
  /// Noms des champs définis par l'admin ou l'utilisateur (JSON string[])
  /// ex: ["adresse","prix","propriétaire"]
  fieldSchema       String                @default("[]")
  /// Template lié (optionnel — peut être déterminé après création du slot)
  templateId        String?
  template          Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Render final rattaché au slot (relation inverse de Render.publicationSlotId)
  render            Render?
  /// true = créé automatiquement par le moteur de génération / cron
  isAuto            Boolean               @default(false)
  notes             String?
  /// Monteur assigné à ce slot
  assigneeMonteurId String?
  assigneeMonteur   User?                 @relation("SlotMonteur", fields: [assigneeMonteurId], references: [id], onDelete: SetNull)
  /// Community manager assigné à ce slot
  assigneeCmId      String?
  assigneeCm        User?                 @relation("SlotCm", fields: [assigneeCmId], references: [id], onDelete: SetNull)
  /// Recipe de contenu associée à ce slot
  recipeId          String?
  recipe            ContentRecipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// Version courante sélectionnée (parmi les versions uploadées)
  currentVersionId  String?               @unique
  currentVersion    PublicationVersion?   @relation("SlotCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// Toutes les versions uploadées pour ce slot
  versions          PublicationVersion[]  @relation("SlotVersions")
  comments          PublicationComment[]
  activities        PublicationActivity[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([accountId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([contentType, scheduledAt])
  @@index([assigneeMonteurId])
  @@index([assigneeCmId])
  @@index([recipeId])
}

model PublicationComment {
  id        String          @id @default(cuid())
  slotId    String
  authorId  String
  body      String          @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  slot      PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  author    User            @relation("PublicationCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([slotId, createdAt])
}

model PublicationActivity {
  id        String          @id @default(cuid())
  slotId    String
  actorId   String?
  type      String
  payload   Json?
  createdAt DateTime        @default(now())
  slot      PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  actor     User?           @relation("PublicationActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([slotId, createdAt])
}

// ─── Clients ─────────────────────────────────────────────────────────────────

/// Client final (agence ou agent immobilier) regroupant un ou plusieurs comptes Instagram.
model Client {
  id          String             @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  accounts    InstagramAccount[]
}

// ─── Content Recipes ──────────────────────────────────────────────────────────

/// Recette de contenu : décrit comment produire un type de contenu (template, lib, besoins).
model ContentRecipe {
  id                       String            @id @default(cuid())
  /// Code métier unique : "RPI", "RTIPS", "VISITE_PERSO"…
  code                     String            @unique
  /// Libellé humain affiché dans l'UI
  label                    String
  /// "auto_template" | "manual_rushes" | "external_upload"
  source                   String
  templateId               String?
  template                 Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  libraryId                String?
  library                  MediaLibrary?     @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  /// "preFilled" | "autoGenerate" | "manualWrite" | "none"
  needsDescription         String            @default("none")
  /// "auto" | "manualSelect" | "none"
  needsCover               String            @default("none")
  needsCaptions            Boolean           @default(false)
  needsClientValidation    Boolean           @default(false)
  defaultAssigneeMonteurId String?
  defaultAssigneeMonteur   User?             @relation("RecipeDefaultMonteur", fields: [defaultAssigneeMonteurId], references: [id], onDelete: SetNull)
  defaultAssigneeCmId      String?
  defaultAssigneeCm        User?             @relation("RecipeDefaultCm", fields: [defaultAssigneeCmId], references: [id], onDelete: SetNull)
  notes                    String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  publicationSlots         PublicationSlot[]
  accountPlans             AccountPlan[]
}

// ─── Account Plans ────────────────────────────────────────────────────────────

/// Plan de publication récurrent d'un compte : un créneau hebdomadaire pour une recipe donnée.
model AccountPlan {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      ContentRecipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Jour ISO : 1=Lundi … 7=Dimanche
  dayOfWeek   Int
  /// Heure cible au format "HH:MM" (ex: "19:00")
  publishTime String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([accountId, dayOfWeek, publishTime, recipeId])
  @@index([accountId])
  @@index([dayOfWeek])
}

// ─── Publication Versions ─────────────────────────────────────────────────────

/// Version d'un fichier uploadé pour un slot de publication.
/// Chaque upload crée une nouvelle version numérotée ; la version active est pointée par PublicationSlot.currentVersionId.
model PublicationVersion {
  id               String           @id @default(cuid())
  slotId           String
  slot             PublicationSlot  @relation("SlotVersions", fields: [slotId], references: [id], onDelete: Cascade)
  versionNumber    Int
  /// Clé R2 déterministe : "publications/<slotId>/versions/<n>.<ext>"
  r2Key            String           @unique
  fileUrl          String
  fileName         String
  fileSizeBytes    Int?
  mimeType         String
  durationSec      Float?
  uploadedByUserId String
  uploadedBy       User             @relation("VersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  notes            String?
  createdAt        DateTime         @default(now())
  /// Slot qui pointe cette version comme courante (relation inverse de PublicationSlot.currentVersionId)
  currentForSlot   PublicationSlot? @relation("SlotCurrentVersion")

  @@unique([slotId, versionNumber])
  @@index([slotId])
}

// ─── Pod On-Demand state ─────────────────────────────────────────────────────

/// État singleton du pod RunPod On-Demand.
/// Persiste le statut et l'URL FastAPI du pod pour éviter les start/stop concurrents.
model PodState {
  /// Toujours "singleton" — une seule ligne en DB.
  id             String    @id @default("singleton")
  /// "stopped" | "starting" | "running" | "stopping"
  status         String    @default("stopped")
  /// ID du pod RunPod actuel (créé dynamiquement depuis un template).
  /// Stocké ici pour survivre aux redémarrages de l'app web.
  podId          String?
  /// URL de base de la FastAPI du pod (ex: https://abc123-8080.proxy.runpod.net)
  podUrl         String?
  /// Timestamp du dernier job dispatché vers le pod (pour le timer d'inactivité)
  lastJobAt      DateTime?
  /// Nombre de jobs en cours sur ce pod (dispatché mais webhook pas encore reçu).
  /// Le pod n'est stoppé que quand activeJobCount = 0 ET idle depuis IDLE_MINUTES.
  activeJobCount Int       @default(0)
  updatedAt      DateTime  @updatedAt
}
