generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String           @id @default(cuid())
  username     String?          @unique
  email        String?          @unique
  passwordHash String
  name         String
  role         String           @default("USER")
  /// JSON array of tool strings — ex: ["templates","captions"]
  permissions  String           @default("[]")
  createdAt    DateTime         @default(now())
  templates    Template[]
  listings     Listing[]
  accesses     TemplateAccess[]
  captionJobs    CaptionJob[]
  captionPresets CaptionPreset[]
  captionPresetAccesses CaptionPresetAccess[]
  transcriptionJobs TranscriptionJob[]
  descriptionJobs   DescriptionJob[]
  derushJobs        DerushJob[]
  derushPresets     DerushPreset[]
  derushPresetAccesses DerushPresetAccess[]
  derushFormats     DerushFormat[]
}

model CaptionJob {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String   @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  inputUrl      String?
  outputUrl     String?
  outputKey     String?  // clé R2 de l'output
  runpodJobId   String?  // ID job RunPod pour polling
  config        String   @default("{}") // JSON sérialisé
  srtContent    String?  // Contenu SRT utilisé pour la génération (pour regénérer)
  presetId      String?  // ID du preset utilisé
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Preset de sous-titres sauvegardé (config complète + polices)
model CaptionPreset {
  id        String   @id @default(cuid())
  name      String
  /// null = preset global/builtin (visible par tous), sinon appartient à l'user
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBuiltin Boolean  @default(false)
  /// ConfigState JSON sérialisé (base, highlight, layout, effects, animation...)
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accesses  CaptionPresetAccess[]
}

model CaptionPresetAccess {
  id        String        @id @default(cuid())
  userId    String
  presetId  String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset    CaptionPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([userId, presetId])
}

model Template {
  id        String           @id @default(cuid())
  name      String
  client    String           @default("")
  formats   String           @default("[]") // JSON array ["A3_LANDSCAPE", "A4_PORTRAIT"]
  jsonData  String           @default("{}") // TemplateJSON sérialisé
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  listings  Listing[]
  renders   Render[]
  accesses  TemplateAccess[]
}

model FontAsset {
  id           String   @id @default(cuid())
  family       String   @unique
  url          String
  storageKey   String?
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TemplateAccess {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model Listing {
  id         String    @id @default(cuid())
  templateId String?
  jsonData   String    @default("{}") // ListingData sérialisé
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  renders    Render[]
}

model Render {
  id           String       @id @default(cuid())
  listingId    String
  templateId   String?
  status       RenderStatus @default(PENDING)
  /// Pipeline utilisé: image | video-local | video-runpod
  pipeline     String?
  /// Étape détaillée pour le suivi UI / debug
  stage        String?
  /// Détail court de progression (humain)
  statusDetail String?
  /// Progression approximative 0..1 pour l'UI
  progress     Float?
  pngUrl       String?
  pdfUrl       String?
  /// URL vidéo finale (renders avec un VideoBlock — pipeline RunPod)
  videoUrl     String?
  /// ID du job RunPod (pour polling — null si pipeline Node.js)
  runpodJobId  String?
  errorMsg     String?
  createdAt    DateTime     @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  lastHeartbeatAt DateTime?
  listing      Listing      @relation(fields: [listingId], references: [id])
  template     Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

enum RenderStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model TranscriptionJob {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  inputKey        String?  // clé R2 du fichier audio source
  inputFilename   String?  // nom original pour l'affichage
  model           String   @default("turbo")  // ex: "turbo", "large-v3"
  language        String   @default("fr")
  enableDiarization Boolean @default(false)  // demande de segmentation par speaker
  hasDiarization  Boolean  @default(false)   // résultat effectif (false si pas de HF_TOKEN)
  runpodJobId     String?  // ID job RunPod pour polling
  outputJsonKey   String?  // clé R2 du JSON segments brut (persistant)
  segmentCount    Int?
  duration        Float?   // durée audio en secondes
  errorMsg        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  descriptionJobs DescriptionJob[]
}

/// Prompt personnalisé pour la génération de descriptions (géré par les admins)
model DescriptionPrompt {
  id        String           @id @default(cuid())
  name      String
  prompt    String           // Instructions pour le LLM
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  jobs      DescriptionJob[]
}

/// Résultat d'une génération de description à partir d'un SRT/JSON
model DescriptionJob {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String             @default("COMPLETED") // COMPLETED | FAILED
  /// "upload" = fichier uploadé, "transcription" = TranscriptionJob existant
  inputType        String             @default("upload")
  inputFilename    String?            // nom du fichier SRT/JSON original
  transcriptionId  String?
  transcription    TranscriptionJob?  @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
  promptId         String?
  prompt           DescriptionPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  /// Snapshot du texte du prompt au moment de la génération
  promptSnapshot   String?
  personalization  String?            // Texte libre injecté dans le prompt
  model            String             @default("claude") // "claude" | "gpt"
  result           String?            // Texte généré
  errorMsg         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ─── Dérush module ────────────────────────────────────────────────────────────

/// Preset de scoring dérush (profils par type de projet)
model DerushPreset {
  id           String   @id @default(cuid())
  name         String
  /// null = builtin visible par tous, sinon appartient à l'user
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBuiltin    Boolean  @default(false)
  /// analysisMode auquel ce preset s'applique
  analysisMode String   @default("vision") // "vision" | "transcription"
  /// DerushPresetConfig JSON (scoringWeights, rejectThresholds, exportDefaults)
  config       String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accesses     DerushPresetAccess[]
  derushJobs   DerushJob[]
}

model DerushPresetAccess {
  id        String        @id @default(cuid())
  userId    String
  presetId  String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset    DerushPreset  @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([userId, presetId])
}

/// Job d'analyse / dérush d'une ou plusieurs vidéos
model DerushJob {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String   @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  /// Pipeline d'analyse choisi explicitement par l'utilisateur
  analysisMode   String   @default("vision") // "transcription" | "vision"
  /// JSON array [{key, filename}] — N fichiers vidéo source sur R2
  inputFiles     String   @default("[]")
  /// ID d'un TranscriptionJob existant (mode transcription, réutilisation)
  transcriptionJobId       String?
  /// Clé R2 d'un SRT ou JSON uploadé directement (mode transcription, import manuel)
  transcriptionInputKey    String?
  /// Preset de scoring appliqué
  presetId       String?
  preset         DerushPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  /// Provider IA vision utilisé
  visionProvider String   @default("heuristic") // "heuristic" | "gemini" | "openai" | "claude"
  runpodJobId    String?
  /// Clé R2 du JSON segments résultat (DerushSegment[])
  outputJsonKey  String?
  segmentCount   Int?
  totalDuration  Float?
  errorMsg       String?
  /// Overrides manuels : {"seg_id": "accepted" | "rejected"} — appliqués par-dessus l'analyse IA
  segmentOverrides String  @default("{}")
  /// Corrections de texte manuelles : {"seg_id": "texte corrigé"} — pour ajuster la transcription IA
  segmentTextOverrides String  @default("{}")
  /// Format de segmentation (RQR, talking_head, etc.)
  formatId       String?
  format         DerushFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)
  /// Demande de segmentation par speaker
  enableDiarization Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  derushExports  DerushExport[]
}

/// Format de segmentation configurable (RQR, talking_head, podcast, etc.)
model DerushFormat {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @default("")
  /// Prompt de contexte envoyé à Gemini (instructions spécifiques au format)
  contextPrompt     String   @default("")
  /// Seuil de silence en secondes entre deux phrases pour les regrouper (0 = désactivé)
  silenceThreshold  Float    @default(1.5)
  /// Mode d'export : "individual" = un clip par segment, "qa_pair" = Q+R groupés ensemble
  exportMode        String   @default("individual") // "individual" | "qa_pair"
  /// true = builtin, non modifiable par les users
  isBuiltin         Boolean  @default(false)
  /// null = builtin visible par tous, sinon appartient à l'user
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  derushJobs        DerushJob[]
}

/// Export d'un DerushJob dans un format spécifique
model DerushExport {
  id           String    @id @default(cuid())
  derushJobId  String
  derushJob    DerushJob @relation(fields: [derushJobId], references: [id], onDelete: Cascade)
  status       String    @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  /// Format d'export
  exportFormat String    // "clips_trimmed" | "xml_timeline" | "stringout_video" | "structured_folder" | "manifest_only" | "combo_export"
  /// Workflow cible (optionnel, influence le naming et format XML)
  workflow     String?   // "capcut" | "premiere" | "resolve" | "generic"
  /// Formats à inclure (pour combo_export) — JSON array de strings
  comboFormats String    @default("[]")
  /// Recode avec précision frame (plus lent, pour timeline pro) vs stream copy (défaut)
  accurateTrim Boolean   @default(false)
  /// Format XML cible pour xml_timeline et combo_export
  xmlFormat    String    @default("fcpxml") // "fcpxml" | "premiere_xml"
  /// Clé R2 du ZIP ou manifest JSON généré
  outputKey    String?
  outputFilename String?
  runpodJobId  String?
  errorMsg     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
