generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                  @id @default(cuid())
  username                      String?                 @unique
  email                         String?                 @unique
  passwordHash                  String
  name                          String
  role                          String                  @default("EXTERNAL_GENERATOR")
  /// JSON array of tool strings — ex: ["templates","captions"]
  permissions                   String                  @default("[]")
  createdAt                     DateTime                @default(now())
  templates                     Template[]
  listings                      Listing[]
  accesses                      TemplateAccess[]
  captionJobs                   CaptionJob[]
  captionPresets                CaptionPreset[]
  captionPresetAccesses         CaptionPresetAccess[]
  transcriptionJobs             TranscriptionJob[]
  descriptionJobs               DescriptionJob[]
  coverFramePacks               CoverFramePack[]
  defaultMonteurForPatterns     AccountPattern[]        @relation("PatternDefaultMonteur")
  defaultCmForPatterns          AccountPattern[]        @relation("PatternDefaultCm")
  uploadedVersions              PublicationVersion[]    @relation("VersionUploader")
  assignedAsMonteur             PublicationSlot[]       @relation("SlotMonteur")
  assignedAsCm                  PublicationSlot[]       @relation("SlotCm")
  publicationComments           PublicationComment[]    @relation("PublicationCommentAuthor")
  publicationActivities         PublicationActivity[]   @relation("PublicationActivityActor")
  briefsUpdated                 PublicationBrief[]      @relation("BriefUpdatedBy")
  rushesUploaded                PublicationRush[]       @relation("RushUploadedBy")
  clientValidationTokensCreated ClientValidationToken[] @relation("ClientValidationTokenCreator")
  assignedAsVideaste            PublicationSlot[]       @relation("SlotVideaste")
  defaultVideasteForPatterns    AccountPattern[]        @relation("PatternDefaultVideaste")
}

model CaptionJob {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String           @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  inputUrl      String?
  inputKey      String? // clé R2 de la vidéo source (supprimée après complétion)
  outputUrl     String?
  outputKey     String? // clé R2 de l'output
  runpodJobId   String?          @unique // ID job RunPod pour polling
  errorMsg      String? // message d'erreur lisible
  config        String           @default("{}") // JSON sérialisé
  srtContent    String? // Contenu SRT utilisé pour la génération (pour regénérer)
  srtFilename   String? // Nom du fichier SRT/JSON d'origine (pour détecter format)
  previewMode   Boolean          @default(false) // true = preview 6s, false = rendu complet
  presetId      String? // ID du preset utilisé
  /// Slot de publication optionnellement lié (Phase 1.9 — A2)
  slotId        String?
  slot          PublicationSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  /// V6 — Job marqué obsolète quand son input upstream change (nouveau render,
  /// nouvelle version promue). Reste consultable mais affiché avec un badge
  /// "Obsolète" dans la fiche pour éviter qu'on prenne pour "courant" un job
  /// lié à une vidéo qui n'est plus la version active.
  staleSince    DateTime?
  staleReason   String? // "version_promoted" | "render_replaced" | "pattern_changed"
  /// V6 — Relation inverse : ce job est-il le "courant" du slot ?
  activeForSlot PublicationSlot? @relation("SlotActiveCaption")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([slotId])
}

/// Preset de sous-titres sauvegardé (config complète + polices)
model CaptionPreset {
  id              String                @id @default(cuid())
  name            String
  /// null = preset global/builtin (visible par tous), sinon appartient à l'user
  userId          String?
  user            User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBuiltin       Boolean               @default(false)
  /// ConfigState JSON sérialisé (base, highlight, layout, effects, animation...)
  config          String                @default("{}")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  accesses        CaptionPresetAccess[]
  accountPatterns AccountPattern[]
  /// Slots one-off référençant ce preset via override (Phase 5 Workflows).
  slotsOverride   PublicationSlot[]     @relation("SlotCaptionPresetOverride")
}

model CaptionPresetAccess {
  id        String        @id @default(cuid())
  userId    String
  presetId  String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset    CaptionPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([userId, presetId])
}

model CaptionPrompt {
  id                     String   @id @default(cuid())
  name                   String
  prompt                 String
  autoHighlightEnabled   Boolean  @default(false)
  autoHighlightMode      String   @default("highlight1")
  autoHighlightPlacement String   @default("after")
  autoHighlightPrompt    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Template {
  id               String                @id @default(cuid())
  name             String
  client           String                @default("")
  formats          String                @default("[]") // JSON array ["A3_LANDSCAPE", "A4_PORTRAIT"]
  jsonData         String                @default("{}") // TemplateJSON sérialisé
  /// Type de contenu éditorial : "RPI" | "RVA4" | "RVA5" | "RTIPS" | "RPOD" | "REACT" | "RQR" | "" (vide = non défini)
  contentType      String                @default("")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  listings         Listing[]
  renders          Render[]
  coverFramePacks  CoverFramePack[]
  accesses         TemplateAccess[]
  publicationSlots PublicationSlot[]
  accountPatterns  AccountPattern[]
  coverPresets     TemplateCoverPreset[]
}

model TemplateCoverPreset {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Nom user-facing du preset (ex: "Standard", "Minimal", "Vibrant")
  name       String
  /// Snapshot config cover : overlayGroupIds, frameCount, offsetX/Y, excludeZones, excludeSlotIds
  config     Json
  /// Ordre d'affichage dans le picker (UI)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Slots one-off référencant ce preset via override (Phase 5 Workflows).
  slotsOverride PublicationSlot[] @relation("SlotCoverPresetOverride")

  @@unique([templateId, name])
  @@index([templateId])
}

model FontAsset {
  id           String   @id @default(cuid())
  family       String
  weight       Int      @default(400)
  fontStyle    String   @default("normal")
  url          String
  storageKey   String?
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([family, weight, fontStyle])
}

model TemplateAccess {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
}

model Listing {
  id         String    @id @default(cuid())
  templateId String?
  jsonData   String    @default("{}") // ListingData sérialisé
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  renders    Render[]
}

model Render {
  id                String            @id @default(cuid())
  listingId         String
  templateId        String?
  status            RenderStatus      @default(PENDING)
  /// Pipeline utilisé: image | video-local | video-runpod
  pipeline          String?
  /// Étape détaillée pour le suivi UI / debug
  stage             String?
  /// Détail court de progression (humain)
  statusDetail      String?
  /// Progression approximative 0..1 pour l'UI
  progress          Float?
  pngUrl            String?
  /// URL vidéo finale (renders avec un VideoBlock — pipeline RunPod)
  videoUrl          String?
  /// ID du job RunPod (pour polling — null si pipeline Node.js)
  runpodJobId       String?           @unique
  errorMsg          String?
  /// JSON map des assets de bibliothèque utilisés pour ce render
  /// { videoAssets: { blockId: assetId }, audioAssetId?: string, dataEntryId?: string, setSequencedLibraryIds?: string[] }
  usedAssets        String            @default("{}")
  /// JSON map { [slotId]: effectiveDurationSeconds } pour les renders sequence.
  /// Renseigné par render-engine (local ou RunPod) après la composition. Utilisé pour
  /// résoudre les bornes temporelles des slots exclus du sous-titrage et de la cover.
  slotDurations     String?
  /// Compte Instagram pour lequel ce render a été généré (optionnel)
  accountId         String?
  account           InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Slot de calendrier auquel ce render est rattaché (optionnel)
  publicationSlotId String?           @unique
  publicationSlot   PublicationSlot?  @relation(fields: [publicationSlotId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  lastHeartbeatAt   DateTime?
  listing           Listing           @relation(fields: [listingId], references: [id])
  template          Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Job de transcription déclenché automatiquement après ce render (si captionAutoConfig activé)
  transcriptionJob  TranscriptionJob?
  /// Pack de frames cover préparé automatiquement après ce render (si coverAutoConfig activé)
  coverFramePack    CoverFramePack?
}

enum RenderStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model TranscriptionJob {
  id                   String              @id @default(cuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String              @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | FAILED
  inputKey             String? // clé R2 du fichier audio source
  inputFilename        String? // nom original pour l'affichage
  model                String              @default("turbo") // ex: "turbo", "large-v3"
  language             String              @default("fr")
  enableDiarization    Boolean             @default(false) // demande de segmentation par speaker
  hasDiarization       Boolean             @default(false) // résultat effectif (false si pas de HF_TOKEN)
  runpodJobId          String?             @unique // ID job RunPod pour polling
  outputJsonKey        String? // clé R2 du JSON segments brut (persistant)
  /// Segments transcription en JSON inline (fallback quand R2 non utilisé, ex
  /// dev local). Format : `[{start, end, text, speaker?}, ...]`. Permet de
  /// rejouer description / autres jobs aval sans dépendre de R2.
  segmentsJson         String?             @db.Text
  segmentCount         Int?
  duration             Float? // durée audio en secondes
  errorMsg             String?
  /// Render à l'origine de ce job (si déclenché automatiquement via captionAutoConfig)
  renderId             String?             @unique
  render               Render?             @relation(fields: [renderId], references: [id], onDelete: SetNull)
  /// PublicationVersion à l'origine de ce job (Phase 2.4 — chaîne auto pour
  /// les patterns manual_rushes / external_upload, alternative à renderId).
  /// Mutuellement exclusif avec renderId en pratique.
  publicationVersionId String?             @unique
  publicationVersion   PublicationVersion? @relation("VersionTranscriptionJob", fields: [publicationVersionId], references: [id], onDelete: SetNull)
  /// Slot manuellement rattaché à ce job (Phase V2 — friction MED-2 audit
  /// 2026-05-31). Utilisé quand on déclenche /transcriptions?slotId= depuis
  /// la fiche : la transcription apparaît alors dans la ProductionChain du
  /// slot même sans render/version liés. Non-unique : un slot peut accumuler
  /// plusieurs transcriptions (relances). onDelete: SetNull pour ne pas
  /// casser l'historique si le slot est archivé.
  slotId               String?
  slot                 PublicationSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  /// V6 — Job marqué obsolète quand son input upstream change (nouvelle
  /// version promue, par exemple).
  staleSince           DateTime?
  staleReason          String? // "version_promoted" | "render_replaced"
  /// V6 — Relation inverse : ce job est-il la "transcription courante" du slot ?
  activeForSlot        PublicationSlot?    @relation("SlotActiveTranscription")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  descriptionJobs      DescriptionJob[]

  @@index([slotId, createdAt])
}

model CoverFramePack {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Render lié au pack — null pour les packs créés manuellement sur une
  /// version uploadée (slot one-off sans render auto, ex: rush externe monté).
  renderId             String?               @unique
  render               Render?               @relation(fields: [renderId], references: [id], onDelete: SetNull)
  /// PublicationVersion lié (alternative à renderId pour les packs manuels).
  publicationVersionId String?               @unique
  publicationVersion   PublicationVersion?   @relation("VersionCoverFramePack", fields: [publicationVersionId], references: [id], onDelete: SetNull)
  templateId           String?
  template             Template?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status               String                @default("QUEUED") // QUEUED | PROCESSING | READY | SELECTED | FAILED
  sourceVideoUrl       String?
  duration             Float?
  frameCount           Int                   @default(36)
  /// JSON string[] — timestamps déjà proposés, pour les tirages suivants.
  usedTimestamps       String                @default("[]")
  /// JSON — snapshot de la config cover au moment de la génération.
  config               String                @default("{}")
  /// JSON string[] — groupes de blocs utilisés comme overlay texte cover.
  overlayGroupIds      String                @default("[]")
  overlayOffsetX       Float                 @default(0)
  overlayOffsetY       Float                 @default(0)
  selectedCandidateId  String?
  finalCoverUrl        String?
  finalCoverKey        String?
  errorMsg             String?
  /// V6 — Pack marqué obsolète quand son input upstream change.
  staleSince           DateTime?
  staleReason          String? // "version_promoted" | "render_replaced"
  /// V6 — Relation inverse : ce pack est-il le "cover courant" du slot ?
  activeForSlot        PublicationSlot?      @relation("SlotActiveCover")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  candidates           CoverFrameCandidate[]

  @@index([userId, status])
  @@index([templateId])
}

model CoverFrameCandidate {
  id            String         @id @default(cuid())
  packId        String
  pack          CoverFramePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  timestamp     Float
  imageUrl      String
  imageKey      String?
  /// VideoSequence slotId d'origine (null pour single-sequence ou frame sans tracking)
  slotId        String?
  /// Index de la source dans videoSequence[] si applicable (0-based)
  sequenceIndex Int?
  createdAt     DateTime       @default(now())

  @@index([packId])
}

/// Prompt personnalisé pour la génération de descriptions (géré par les admins)
model DescriptionPrompt {
  id              String            @id @default(cuid())
  name            String
  prompt          String // Instructions pour le LLM
  isActive        Boolean           @default(true)
  /// Recipe d'exécution bundlée au prompt (P6).
  /// Valeurs : "transcript_only" (défaut, comportement historique) |
  /// "transcript_and_frame" | "transcript_multi_frame" | "two_pass_reformulate" |
  /// "context_enriched". L'executor lit ce champ pour choisir la stratégie.
  recipeKind      String            @default("transcript_only")
  /// Config JSON spécifique à la recipe (frame count, fields à injecter, etc.)
  recipeConfig    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  jobs            DescriptionJob[]
  accountPatterns AccountPattern[]
  /// Slots one-off référençant ce prompt via override (Phase 5 Workflows).
  slotsOverride   PublicationSlot[] @relation("SlotDescriptionPromptOverride")
}

/// Résultat d'une génération de description à partir d'un SRT/JSON
model DescriptionJob {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String             @default("COMPLETED") // COMPLETED | FAILED
  /// "upload" = fichier uploadé, "transcription" = TranscriptionJob existant
  inputType       String             @default("upload")
  inputFilename   String? // nom du fichier SRT/JSON original
  transcriptionId String?
  transcription   TranscriptionJob?  @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
  promptId        String?
  prompt          DescriptionPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  /// Snapshot du texte du prompt au moment de la génération
  promptSnapshot  String?
  personalization String? // Texte libre injecté dans le prompt
  model           String             @default("claude") // "claude" | "gpt"
  result          String? // Texte généré
  errorMsg        String?
  /// Slot de publication optionnellement lié (alimente la ProductionChain)
  slotId          String?
  slot            PublicationSlot?   @relation(fields: [slotId], references: [id], onDelete: SetNull)
  /// V6 — Job marqué obsolète quand son input upstream change. Note : pas
  /// d'activeForSlot — la description vit dans slot.description (texte).
  staleSince      DateTime?
  staleReason     String? // "version_promoted" | "render_replaced"
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([slotId])
}

// ─── Content Library ─────────────────────────────────────────────────────────

/// Bibliothèque de médias (vidéos rush ou musiques). Gérée par les admins.
model MediaLibrary {
  id             String                 @id @default(cuid())
  name           String
  /// "video" | "audio"
  type           String
  /// JSON string[] — tags de type template : ["RPI","RTIPS","RPOD"]
  tags           String                 @default("[]")
  description    String?
  /// JSON string[] — ordre explicite des setTags pour la rotation : ["tenue1-set1","tenue2-set1","tenue1-set2"]
  setSequence    String                 @default("[]")
  /// JSON Record<string,string> — setTag → famille : {"tenue1-set1":"tenue1","tenue1-set2":"tenue1","tenue2-set1":"tenue2"}
  /// En mode auto, tous les setTags d'une même famille sont exclus ensemble après utilisation.
  /// Portée de la rotation :
  /// - "per_account" (défaut) : curseur et usages séparés par compte. Chaque négociateur avance
  ///   dans la bibliothèque indépendamment des autres.
  /// - "shared" : un seul curseur partagé entre tous les comptes. Tous les comptes voient le
  ///   même contenu à chaque génération (utile pour une bibliothèque commune).
  rotationScope  String                 @default("per_account")
  /// JSON { key: string; label: string; type: "text" | "number" | "url" }[] — champs de
  /// métadonnées structurées pouvant être remplis sur chaque asset de cette bibliothèque.
  metadataSchema String                 @default("[]")
  /// Burn-once / consommation max par asset.
  /// - `null` (défaut) : rotation infinie, les assets sont recyclés quand tous épuisés.
  /// - `N > 0` : chaque asset peut être utilisé max N fois avant d'être filtré de la rotation.
  /// La sémantique dépend de rotationScope :
  /// - `per_account` : N usages MAX par compte (MediaAssetUsage.usageCount par (asset, account))
  /// - `shared`      : N usages MAX au total tous comptes confondus (MediaAsset.usageCount global)
  maxUsageCount  Int?
  /// Mode de rotation explicite :
  /// - `"auto"` (défaut) : least-used round-robin (déduit aussi de setSequence vide en legacy).
  /// - `"override"` : ordre fixe défini par setSequence.
  /// - `"none"` : pas de rotation auto. La sélection se fait via `selectMediaAssetByMetadataValue`
  ///   (champ formulaire du builder). selectMediaAsset() et selectMediaAssetBySetSequence()
  ///   retournent null directement pour cette lib.
  /// - `null` : back-compat — comportement déduit du contenu de setSequence (vide=auto, rempli=override).
  rotationMode   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  assets         MediaAsset[]
  accountCursors AccountLibraryCursor[]
  autocutBatches MediaAutocutBatch[]
  autocutJobs    MediaAutocutJob[]
}

/// Un fichier média dans une bibliothèque (stocké sur R2).
model MediaAsset {
  id          String             @id @default(cuid())
  libraryId   String
  library     MediaLibrary       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  filename    String
  r2Key       String             @unique
  url         String
  /// "video/mp4" | "audio/mpeg" etc.
  mimeType    String
  /// Durée en secondes (remplie au probe après upload)
  duration    Float?
  /// JSON string[] — tags métier associés au fichier : ["RPI","RTIPS","RPOD"]
  tags        String             @default("[]")
  /// Clé de groupement pour les paires intro/outro (même lieu, même tenue).
  /// Les assets partageant le même setTag sont sélectionnés ensemble lors d'une résolution theme_sequence.
  setTag      String?
  /// Catégorie de rotation : stockée par asset (permet le même nom de set dans plusieurs catégories).
  /// L'unité de rotation est le couple (category, setTag). Null = pas de catégorie assignée.
  category    String?
  /// Nombre de fois utilisé dans une génération (agrégat global)
  usageCount  Int                @default(0)
  /// Dernier timestamp d'utilisation global (agrégat de tous comptes)
  lastUsedAt  DateTime?
  /// Désactivé de la rotation : reste dans la bibliothèque mais jamais suggéré
  disabled    Boolean            @default(false)
  /// JSON Record<string, string | number | null> — valeurs de métadonnées structurées
  /// définies par le MediaLibrary.metadataSchema de la bibliothèque parente.
  metadata    String             @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  editJobs    MediaEditJob[]
  /// Entrées de contrôle d'accès (0 entrées = global/tous comptes)
  accesses    MediaAssetAccess[]
  /// Suivi d'utilisation par compte
  usages      MediaAssetUsage[]
  autocutJobs MediaAutocutJob[]
}

/// Job d'édition d'un rush (trim, audio fix). Traitement RunPod, destructif (écrase l'original).
model MediaEditJob {
  id         String           @id @default(cuid())
  assetId    String
  asset      MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// "pending" | "processing" | "done" | "failed"
  status     String           @default("pending")
  /// JSON MediaEditParams : { trimStart?, trimEnd?, mixToMono?, normalize?, gainDb? }
  params     String           @default("{}")
  runpodId   String?          @unique
  errorMsg   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  autocutJob MediaAutocutJob?

  /// Accélère le filtre status actif sur les includes (/assets et /assets/active-jobs)
  @@index([assetId, status])
}

/// Pack RunPod d'analyse autocut : un job RunPod traite N assets en série (Whisper chargé une seule fois).
model MediaAutocutBatch {
  id         String            @id @default(cuid())
  libraryId  String
  library    MediaLibrary      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// "pending" | "processing" | "done" | "partial" | "failed"
  status     String            @default("pending")
  totalCount Int               @default(0)
  doneCount  Int               @default(0)
  failCount  Int               @default(0)
  runpodId   String?           @unique
  errorMsg   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  jobs       MediaAutocutJob[]
}

/// Analyse Whisper d'un seul asset — propose des timings de coupe.
model MediaAutocutJob {
  id             String             @id @default(cuid())
  assetId        String
  asset          MediaAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  libraryId      String
  library        MediaLibrary       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          MediaAutocutBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// "pending" | "processing" | "done" | "failed"
  status         String             @default("pending")
  /// Détecté par Whisper (en secondes, avec padding)
  proposedStart  Float?
  proposedEnd    Float?
  /// JSON [{ text, start, end }] — segments niveau phrase uniquement (pas les mots)
  transcriptJson String?
  language       String?
  /// "pending_review" | "accepted" | "skipped" | "applied"
  reviewStatus   String             @default("pending_review")
  /// Timings confirmés par l'admin (peut différer de proposed si ajustement manuel)
  confirmedStart Float?
  confirmedEnd   Float?
  /// FK vers le MediaEditJob créé lors de l'apply
  editJobId      String?            @unique
  editJob        MediaEditJob?      @relation(fields: [editJobId], references: [id], onDelete: SetNull)
  errorMsg       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  /// Accélère le filtre actif dans autocut-packs (status in [pending, processing])
  @@index([assetId, status])
  /// Accélère autocut-queue (where libraryId + orderBy reviewStatus)
  @@index([libraryId, reviewStatus])
}

/// Bibliothèque de données texte, rattachée à un type de template (RPI, RTIPS…).
model DataLibrary {
  id              String                     @id @default(cuid())
  name            String
  /// Identifiant métier du type : "RPI" | "RTIPS" | "RPOD" | etc.
  templateType    String
  description     String?
  /// Mode de rotation explicite (mirror MediaLibrary) :
  /// - "auto"     : least-used round-robin (défaut).
  /// - "override" : ordre fixe (TODO V2 : nécessitera DataEntry.position).
  /// - "none"     : pas de rotation auto, sélection manuelle uniquement.
  rotationMode    String                     @default("auto")
  /// Portée de la rotation (mirror MediaLibrary) :
  /// - "shared" (défaut)  : pool partagé entre tous les comptes (compteur global DataEntry.usageCount).
  /// - "per_account"      : chaque compte tourne indépendamment (DataEntryUsage par compte).
  rotationScope   String                     @default("shared")
  /// Burn-once / consommation max par fiche.
  /// - `null` (défaut) : rotation infinie, fiches recyclées (least-used).
  /// - `N > 0` : chaque fiche peut être utilisée max N fois (filtrée au-delà).
  /// Sémantique dépend de rotationScope (shared → global / per_account → per-account).
  maxUsageCount   Int?
  /// JSON `{ key, label, type, required? }[]` — schéma des champs d'une fiche.
  /// Sert à : générer le modèle CSV (même lib vide), construire le form de
  /// création/édition d'une fiche, valider l'import.
  /// types supportés : "text" | "number" | "url" | "textarea".
  /// Si vide → fallback rétrocompatible (déduction depuis la première entry).
  fieldsSchema    String                     @default("[]")
  /// Token de remplissage public (Phase 1.x Vague 3). Si non-null, la lib
  /// expose une page sans auth à `/data-fill/<token>` où un externe peut
  /// soumettre des fiches. Le token est révocable / régénérable depuis l'admin.
  publicFillToken String?                    @unique
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  campaigns       DataCampaign[]
  cursors         AccountDataLibraryCursor[]
}

/// Cycle de données (ex: "RPI Q1 2026"). Une fiche active à la fois par library.
model DataCampaign {
  id           String      @id @default(cuid())
  libraryId    String
  library      DataLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Nom du cycle, ex: "RPI Q1 2026"
  name         String
  isActive     Boolean     @default(true)
  /// Date du dernier reset de cycle (tous les usedInCycle remis à false)
  cycleResetAt DateTime?
  ///
  /// Politique d'utilisation des fiches :
  /// - "cycle"             : tour à tour global. usedInCycle=true après usage, reset manuel.
  /// - "cycle_per_account" : tour à tour par compte. Chaque compte consomme ses fiches
  ///                         indépendamment ; quand tout est utilisé → recommence.
  /// - "once_per_account"  : max 1 usage par compte. Une fois toutes les fiches utilisées
  ///                         par un compte, plus rien n'est suggéré.
  /// - "once_global"       : max 1 usage au total tous comptes confondus.
  /// - "unlimited"         : pas de contrainte, toujours least_used.
  usagePolicy  String      @default("cycle")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entries      DataEntry[]
}

/// Une fiche de données texte (une ligne de l'Excel d'origine).
model DataEntry {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    DataCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// JSON — champs libres selon le templateType (ex: {quartier, prix_m2, evo_5ans_pct})
  fields      String            @default("{}")
  /// Identifiant de set (regroupe les fiches d'un même thème/lot).
  setTag      String?
  /// Famille de sets — utilisé pour l'exclusion consécutive en rotation auto.
  category    String?
  usageCount  Int               @default(0)
  lastUsedAt  DateTime?
  /// Remis à false au reset de cycle. Permet la règle "pas encore utilisé ce cycle".
  usedInCycle Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  accesses    DataEntryAccess[]
  usages      DataEntryUsage[]
}

/// Compte Instagram client géré par l'admin (pas de login propre dans l'app).
model InstagramAccount {
  id               String                     @id @default(cuid())
  name             String
  /// Handle Instagram sans le @
  handle           String                     @unique
  clientId         String?
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  cursors          AccountLibraryCursor[]
  dataCursors      AccountDataLibraryCursor[]
  renders          Render[]
  publicationSlots PublicationSlot[]
  assetAccesses    MediaAssetAccess[]
  assetUsages      MediaAssetUsage[]
  entryAccesses    DataEntryAccess[]
  entryUsages      DataEntryUsage[]
  accountPatterns  AccountPattern[]

  @@index([clientId])
}

/// Contrôle d'accès d'une fiche de données par compte.
/// 0 entrée pour une fiche = accès global. 1+ entrées = restreint aux comptes listés.
model DataEntryAccess {
  entryId   String
  accountId String
  entry     DataEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entryId, accountId])
}

/// Suivi d'utilisation d'une fiche de données par compte.
/// Permet la rotation indépendante pour chaque négociateur partageant une bibliothèque de données.
model DataEntryUsage {
  entryId    String
  accountId  String
  lastUsedAt DateTime?
  usageCount Int              @default(0)
  entry      DataEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entryId, accountId])
}

/// Contrôle d'accès d'un asset par compte : si au moins une entrée existe pour cet asset,
/// seuls les comptes listés peuvent utiliser cet asset. 0 entrée = accès global.
model MediaAssetAccess {
  assetId   String
  accountId String
  asset     MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([assetId, accountId])
}

/// Suivi d'utilisation par compte : compteur et date d'utilisation isolés par compte.
/// Permet la rotation indépendante pour chaque négociateur partageant une bibliothèque.
model MediaAssetUsage {
  assetId    String
  accountId  String
  lastUsedAt DateTime?
  usageCount Int              @default(0)
  asset      MediaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([assetId, accountId])
}

/// Curseur de position dans la séquence de thèmes d'une bibliothèque, par compte Instagram.
/// Clé composite unique (accountId, libraryId) — chaque compte avance indépendamment.
model AccountLibraryCursor {
  id               String           @id @default(cuid())
  accountId        String
  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  libraryId        String
  library          MediaLibrary     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Index courant dans MediaLibrary.setSequence (mode override uniquement)
  cursor           Int              @default(0)
  /// Dernier setTag utilisé — permet d'éviter deux fois le même groupe de suite (mode auto et override)
  lastUsedSetTag   String?
  /// Dernière catégorie utilisée — pour l'exclusion famille en mode auto (deux sets de même catégorie ne se suivent pas)
  lastUsedCategory String?
  lastAdvancedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([accountId, libraryId])
}

/// Curseur de rotation par compte pour une DataLibrary (mirror simplifié de AccountLibraryCursor).
/// Garde la dernière catégorie et le dernier setTag utilisés pour permettre l'exclusion consécutive
/// en mode auto. Pas de `cursor` Int (DataLibrary n'a pas encore de setSequence/mode override).
model AccountDataLibraryCursor {
  id               String           @id @default(cuid())
  accountId        String
  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  libraryId        String
  library          DataLibrary      @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  /// Dernier setTag utilisé par ce compte sur cette lib — évite de répéter deux fois le même set de suite.
  lastUsedSetTag   String?
  /// Dernière catégorie utilisée — pour l'exclusion famille en mode auto (deux sets de même catégorie ne se suivent pas).
  lastUsedCategory String?
  lastAdvancedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([accountId, libraryId])
}

/// Slot réel dans le calendrier opérationnel pour un compte Instagram donné.
model PublicationSlot {
  id                 String           @id @default(cuid())
  accountId          String
  account            InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Date et heure cible de publication (UTC)
  scheduledAt        DateTime
  /// "TO_DO" | "IN_PROGRESS" | "READY" | "CHECKING" | "DONE"
  status             String           @default("TO_DO")
  title              String?
  /// Texte de la légende Instagram (rédigée par la CM ou générée par IA).
  /// Anciennement scindée en `caption` + `description` — fusionnée Phase 2.1.
  /// Distinct de `notes` qui reste réservé aux notes internes.
  description        String?
  /// Champs libres saisis par l'utilisateur (JSON Record<string, string>)
  /// ex: {"adresse":"12 rue ...","prix":"350 000 €","propriétaire":"Dupont"}
  fields             String           @default("{}")
  /// Noms des champs définis par l'admin ou l'utilisateur (JSON string[])
  /// ex: ["adresse","prix","propriétaire"]
  fieldSchema        String           @default("[]")
  /// Template lié (optionnel — peut être déterminé après création du slot)
  templateId         String?
  template           Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Render final rattaché au slot (relation inverse de Render.publicationSlotId)
  render             Render?
  /// true = créé automatiquement par le moteur de génération / cron
  isAuto             Boolean          @default(false)
  notes              String?
  /// URL Instagram de la publication (renseignée via mark-published)
  publishedUrl       String?
  /// Date effective de publication sur Instagram (renseignée via mark-published)
  publishedAt        DateTime?
  /// Monteur assigné à ce slot
  assigneeMonteurId  String?
  assigneeMonteur    User?            @relation("SlotMonteur", fields: [assigneeMonteurId], references: [id], onDelete: SetNull)
  /// Community manager assigné à ce slot
  assigneeCmId       String?
  assigneeCm         User?            @relation("SlotCm", fields: [assigneeCmId], references: [id], onDelete: SetNull)
  /// Vidéaste assigné au shoot (celui qui filme + upload les rushs)
  assigneeVideasteId String?
  assigneeVideaste   User?            @relation("SlotVideaste", fields: [assigneeVideasteId], references: [id], onDelete: SetNull)
  /// Pattern de contenu associé à ce slot
  patternId          String?
  pattern            AccountPattern?  @relation(fields: [patternId], references: [id], onDelete: SetNull)

  /// Override per-slot de needsAdminValidation du pattern. null = hérite.
  /// Phase 2.3 : permet d'activer la validation admin du montage (status
  /// EDIT_REVIEW intercalé) sur ce slot précis, indépendamment du pattern.
  needsAdminValidationOverride  Boolean?
  /// Override per-slot de needsClientValidation du pattern. null = hérite du pattern.
  needsClientValidationOverride Boolean?
  /// Override per-slot de allowsClientRevision du pattern. null = hérite du pattern.
  allowsClientRevisionOverride  Boolean?
  /// @deprecated V8 — utiliser needsCaptionsModeOverride.
  needsCaptionsOverride         Boolean?
  /// V8 — Override per-slot du mode captions enum. null = hérite du pattern.
  /// Valeurs : "none" | "auto" | "manual".
  needsCaptionsModeOverride     String?
  /// Override per-slot de needsDescription du pattern (enum String). null = hérite.
  /// Valeurs : "preFilled" | "autoGenerate" | "manualWrite" | "none".
  needsDescriptionOverride      String?
  /// Override per-slot de needsRushes du pattern. null = hérite.
  needsRushesOverride           Boolean?
  /// Override per-slot de needsBrief du pattern. null = hérite.
  needsBriefOverride            Boolean?
  /// Override per-slot du mode cover (Phase 2.5 :
  /// "none" | "manualSelect" | "autoPack" | "monteurUpload"). null = hérite.
  coverModeOverride             String?
  /// Override per-slot de l'ID du preset cover utilisé. null = hérite.
  coverPresetIdOverride         String?
  coverPresetOverride           TemplateCoverPreset?    @relation("SlotCoverPresetOverride", fields: [coverPresetIdOverride], references: [id], onDelete: SetNull)
  /// Override per-slot de l'ID du preset captions utilisé. null = hérite.
  captionPresetIdOverride       String?
  captionPresetOverride         CaptionPreset?          @relation("SlotCaptionPresetOverride", fields: [captionPresetIdOverride], references: [id], onDelete: SetNull)
  /// Override per-slot du décalage vertical des captions (fraction de la
  /// hauteur vidéo, range [-0.5, 0.5]). null = utilise la valeur du preset
  /// (typiquement 0 = centré sur l'anchor). Permet au monteur de décaler
  /// ponctuellement sans modifier le preset partagé. Le change cascade
  /// stale-mark le CaptionJob courant (re-trigger nécessaire pour appliquer).
  captionVerticalOffsetOverride Float?
  /// Override per-slot de l'ID du prompt description IA. null = hérite.
  descriptionPromptIdOverride   String?
  descriptionPromptOverride     DescriptionPrompt?      @relation("SlotDescriptionPromptOverride", fields: [descriptionPromptIdOverride], references: [id], onDelete: SetNull)
  /// Tokens magic link pour validation client (un seul actif via clause unique conditionnelle)
  clientValidationTokens        ClientValidationToken[]
  /// Historique des rounds de validation client (un round = une action client)
  clientValidationRounds        ClientValidationRound[]
  /// Version courante sélectionnée (parmi les versions uploadées)
  currentVersionId              String?                 @unique
  currentVersion                PublicationVersion?     @relation("SlotCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// Toutes les versions uploadées pour ce slot
  versions                      PublicationVersion[]    @relation("SlotVersions")
  comments                      PublicationComment[]
  activities                    PublicationActivity[]
  brief                         PublicationBrief?
  rushes                        PublicationRush[]
  /// Jobs captions liés à ce slot (Phase 1.9 — A2)
  captionJobs                   CaptionJob[]
  /// Jobs description IA liés à ce slot (alimente la ProductionChain)
  descriptionJobs               DescriptionJob[]
  /// Jobs transcription liés à ce slot (Phase V2 — friction MED-2). Lien
  /// direct utile pour les transcriptions créées manuellement via le tool
  /// standalone avec ?slotId= : sans cette FK, elles n'apparaissaient pas
  /// dans la ProductionChain du slot.
  transcriptionJobs             TranscriptionJob[]
  /// V6 — Jobs actifs : ceux affichés dans la fiche (vs "latest by createdAt"
  /// qui était trompeur quand un retry PROCESSING masquait un COMPLETED).
  /// Helper resolveActive*Job() fait fallback latest COMPLETED non-stale si null.
  activeCaptionJobId            String?                 @unique
  activeCaptionJob              CaptionJob?             @relation("SlotActiveCaption", fields: [activeCaptionJobId], references: [id], onDelete: SetNull)
  activeCoverPackId             String?                 @unique
  activeCoverPack               CoverFramePack?         @relation("SlotActiveCover", fields: [activeCoverPackId], references: [id], onDelete: SetNull)
  activeTranscriptionJobId      String?                 @unique
  activeTranscriptionJob        TranscriptionJob?       @relation("SlotActiveTranscription", fields: [activeTranscriptionJobId], references: [id], onDelete: SetNull)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@index([accountId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([assigneeMonteurId])
  @@index([assigneeCmId])
  @@index([assigneeVideasteId])
  @@index([patternId])
}

model PublicationComment {
  id        String          @id @default(cuid())
  slotId    String
  authorId  String
  body      String          @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  slot      PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  author    User            @relation("PublicationCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([slotId, createdAt])
}

model PublicationActivity {
  id        String          @id @default(cuid())
  slotId    String
  actorId   String?
  type      String
  payload   Json?
  createdAt DateTime        @default(now())
  slot      PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  actor     User?           @relation("PublicationActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([slotId, createdAt])
}

// ─── Clients ─────────────────────────────────────────────────────────────────

/// Client final (agence ou agent immobilier) regroupant un ou plusieurs comptes Instagram.
model Client {
  id          String             @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  accounts    InstagramAccount[]
}

// ─── Account Patterns ─────────────────────────────────────────────────────────

/// Pattern de publication par compte : combine la config de production (ex-ContentRecipe)
/// et le planning hebdomadaire (ex-AccountPlan) sous une entité unique liée à un compte IG.
model AccountPattern {
  id        String           @id @default(cuid())
  accountId String
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Libellé user-facing : ex "Post Lundi 9h"
  label     String

  // Source du contenu
  source     String // "auto_template" | "manual_rushes" | "external_upload"
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Cover config (Phase 2.5 — refonte des modes)
  //   "none"         : pas de cover
  //   "manualSelect" : CM choisit librement une frame depuis la vidéo finale
  //   "autoPack"     : pack auto extrait via preset, CM sélectionne la finale
  //   "monteurUpload": le monteur uploade la cover en même temps que sa version
  //                   (uniquement valide pour pattern.source = "manual_rushes")
  coverMode   String @default("none")
  coverConfig Json? // CoverAutoConfig snapshot si coverMode="autoPack"

  // Flags besoins
  needsDescription      String  @default("none") // "preFilled" | "autoGenerate" | "manualWrite" | "none"
  /// @deprecated V8 — utiliser needsCaptionsMode. Conservé pour rollback ;
  /// suppression définitive après vérification logs (~1 mois).
  needsCaptions         Boolean @default(false)
  /// V8 — Mode captions enum : "none" | "auto" (preset + IA Whisper/RunPod)
  /// | "manual" (écrit à la main via CaptionEditor depuis la fiche pub).
  /// Backfill : true → "auto", false → "none".
  needsCaptionsMode     String  @default("none") // "none" | "auto" | "manual"
  /// Phase 2.3 — Si true, le montage uploadé passe par EDIT_REVIEW (validation
  /// admin) avant d'être promu et de continuer. Si false, la version uploadée
  /// devient automatiquement currentVersion et le slot saute en EDIT_APPROVED.
  /// Par défaut false : workflow rapide ; l'admin peut activer le garde-fou
  /// au pattern ou au slot si besoin.
  needsAdminValidation  Boolean @default(false)
  needsClientValidation Boolean @default(false)
  /// Si true, le client peut refuser avec commentaire (CLIENT_REVISION → ping-pong).
  /// Si false, le client peut seulement valider ou annuler complètement.
  allowsClientRevision  Boolean @default(false)
  needsRushes           Boolean @default(false)
  needsBrief            Boolean @default(false)

  // Planning (intégré au pattern)
  dayOfWeek   Int[] // [1..7] — 1=Lundi … 7=Dimanche ; tableau pour multi-jour
  publishTime String // "HH:MM"
  isActive    Boolean @default(true)

  // Assignations par défaut
  defaultAssigneeMonteurId  String?
  defaultAssigneeMonteur    User?   @relation("PatternDefaultMonteur", fields: [defaultAssigneeMonteurId], references: [id], onDelete: SetNull)
  defaultAssigneeCmId       String?
  defaultAssigneeCm         User?   @relation("PatternDefaultCm", fields: [defaultAssigneeCmId], references: [id], onDelete: SetNull)
  defaultAssigneeVideasteId String?
  defaultAssigneeVideaste   User?   @relation("PatternDefaultVideaste", fields: [defaultAssigneeVideasteId], references: [id], onDelete: SetNull)

  // Presets par défaut pour la chaîne de production
  captionPresetId     String?
  captionPreset       CaptionPreset?     @relation(fields: [captionPresetId], references: [id], onDelete: SetNull)
  descriptionPromptId String?
  descriptionPrompt   DescriptionPrompt? @relation(fields: [descriptionPromptId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publicationSlots PublicationSlot[]

  @@index([accountId])
  @@index([accountId, isActive])
}

// ─── Client Validation (W2) ───────────────────────────────────────────────────

/// Magic link token pour qu'un client externe valide un slot sans compte sur l'app.
/// Un seul token actif (non révoqué) par slot via clause unique conditionnelle.
/// Le tokenHash est un sha256 ; le rawToken n'est jamais stocké.
model ClientValidationToken {
  id              String          @id @default(cuid())
  slotId          String
  slot            PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// sha256(rawToken). Permet lookup safe (timing-safe equal côté code).
  tokenHash       String          @unique
  createdAt       DateTime        @default(now())
  expiresAt       DateTime
  /// Si non null, le token est révoqué et ne doit plus matcher.
  revokedAt       DateTime?
  /// ADMIN qui a généré ce token (audit).
  createdByUserId String
  createdBy       User            @relation("ClientValidationTokenCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([slotId, revokedAt])
}

/// Round de validation client : une action (approve/reject/cancel) effectuée par le client
/// via le magic link. roundNumber = 1 pour le premier round, incrémenté à chaque renvoi.
model ClientValidationRound {
  id          String          @id @default(cuid())
  slotId      String
  slot        PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  roundNumber Int
  /// "approved" | "rejected" (avec comment, allowsClientRevision=true) | "cancelled"
  action      String
  comment     String?
  respondedAt DateTime        @default(now())

  @@unique([slotId, roundNumber])
  @@index([slotId, respondedAt])
}

// ─── Publication Versions ─────────────────────────────────────────────────────

/// Version d'un fichier uploadé pour un slot de publication.
/// Chaque upload crée une nouvelle version numérotée ; la version active est pointée par PublicationSlot.currentVersionId.
model PublicationVersion {
  id               String            @id @default(cuid())
  slotId           String
  slot             PublicationSlot   @relation("SlotVersions", fields: [slotId], references: [id], onDelete: Cascade)
  versionNumber    Int
  /// Clé R2 déterministe : "publications/<slotId>/versions/<n>.<ext>"
  r2Key            String            @unique
  fileUrl          String
  fileName         String
  fileSizeBytes    Int?
  mimeType         String
  durationSec      Float?
  uploadedByUserId String
  uploadedBy       User              @relation("VersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  notes            String?
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?
  /// Slot qui pointe cette version comme courante (relation inverse de PublicationSlot.currentVersionId)
  currentForSlot   PublicationSlot?  @relation("SlotCurrentVersion")
  /// CoverFramePack créé manuellement sur cette version (Phase 5 slots one-off).
  coverFramePack   CoverFramePack?   @relation("VersionCoverFramePack")
  /// TranscriptionJob auto-déclenché sur cette version (Phase 2.4 — chaîne
  /// auto pour manual_rushes / external_upload).
  transcriptionJob TranscriptionJob? @relation("VersionTranscriptionJob")

  @@unique([slotId, versionNumber])
  @@index([slotId])
  @@index([slotId, deletedAt])
}

// ─── Publication Briefs & Rushes ─────────────────────────────────────────────

/// Brief éditorial d'un slot (markdown, pièces jointes). 1-to-1 avec PublicationSlot.
model PublicationBrief {
  id              String                       @id @default(cuid())
  slotId          String                       @unique
  slot            PublicationSlot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  body            String?                      @db.Text
  updatedAt       DateTime                     @updatedAt
  updatedByUserId String?
  updatedBy       User?                        @relation("BriefUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attachments     PublicationBriefAttachment[]
}

/// Pièce jointe (PDF, image) liée à un brief de publication.
model PublicationBriefAttachment {
  id        String           @id @default(cuid())
  briefId   String
  brief     PublicationBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  r2Key     String           @unique
  fileName  String
  mimeType  String
  sizeBytes Int?
  createdAt DateTime         @default(now())

  @@index([briefId])
}

/// Rush vidéo uploadé pour un slot (soft-deletable).
model PublicationRush {
  id               String          @id @default(cuid())
  slotId           String
  slot             PublicationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  r2Key            String          @unique
  fileName         String
  mimeType         String
  sizeBytes        Int?
  durationSec      Float?
  uploadedByUserId String
  uploadedBy       User            @relation("RushUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  uploadedAt       DateTime        @default(now())
  deletedAt        DateTime?

  @@index([slotId, deletedAt])
}

// ─── Pod On-Demand state ─────────────────────────────────────────────────────

/// État singleton du pod RunPod On-Demand.
/// Persiste le statut et l'URL FastAPI du pod pour éviter les start/stop concurrents.
model PodState {
  /// Toujours "singleton" — une seule ligne en DB.
  id             String    @id @default("singleton")
  /// "stopped" | "starting" | "running" | "stopping"
  status         String    @default("stopped")
  /// ID du pod RunPod actuel (créé dynamiquement depuis un template).
  /// Stocké ici pour survivre aux redémarrages de l'app web.
  podId          String?
  /// URL de base de la FastAPI du pod (ex: https://abc123-8080.proxy.runpod.net)
  podUrl         String?
  /// Timestamp du dernier job dispatché vers le pod (pour le timer d'inactivité)
  lastJobAt      DateTime?
  /// Nombre de jobs en cours sur ce pod (dispatché mais webhook pas encore reçu).
  /// Le pod n'est stoppé que quand activeJobCount = 0 ET idle depuis IDLE_MINUTES.
  activeJobCount Int       @default(0)
  updatedAt      DateTime  @updatedAt
}
