# Worktree ui-boost — example env.

# Active le playground sandbox sur /playground (sinon 404).
NEXT_PUBLIC_DEV_PLAYGROUND=1

# Pour la suite du dev (db, R2, etc.), copie tes valeurs depuis
# ../Toolbox-immo/web/.env.local. Le fichier .env.local lui-même est
# gitignored — chaque worktree garde ses secrets en local.

# --- Pool de connexions DB (PROD) -------------------------------------------
# Prisma utilise par défaut ~num_cpus*2+1 connexions (souvent 5-9). Sous charge
# (rafale de jobs/renders + SSE + polling), le pool se vide et les requêtes
# attendent pool_timeout puis échouent (P2024). Sur PROD, ajouter à DATABASE_URL :
#   ?connection_limit=15&pool_timeout=20
# (N < max_connections Postgres ; ajuster selon vCPU réels du serveur.)
# Ex : postgresql://user:pass@host:5432/toolbox?connection_limit=15&pool_timeout=20
