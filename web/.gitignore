# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Note : les fichiers .env.*.example sont commités (templates documentés).
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups (local only, never commit)
backups/

# Local dev uploads — fallback quand R2 n'est pas configuré.
# Servi par Next.js static à /uploads/{key}. Jamais déployé en prod.
/public/uploads/

# Playwright auth state for screenshot scripts (local only)
.playwright-auth.json
