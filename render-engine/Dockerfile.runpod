# ─────────────────────────────────────────────────────────────────────────────
# Image de production RunPod — base CUDA pour NVENC (h264_nvenc)
# NE PAS utiliser requirements.txt (contient Gradio ~2.5GB inutile en prod)
# ─────────────────────────────────────────────────────────────────────────────

# CUDA 12.8 cudnn-runtime : runtime + cuDNN, sans headers/nvcc de compilation (~2.7 GB vs ~6.5 GB devel).
# cudnn-runtime requis (pas runtime seul) : ctranslate2/faster-whisper nécessite libcudnn.so
# pour l'inférence GPU sur modèles Whisper (couches convolutionnelles).
# RunPod GPU attend une image linux/amd64.
# La sélection de plateforme se fait au moment du build via docker buildx --platform linux/amd64.
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

# Système : Python 3.11 + dépendances de base
# FFmpeg sera installé via build statique BtbN (NVENC embarqué, pas de dépendance host)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3-pip \
    fontconfig \
    libass9 \
    libpango-1.0-0 \
    libsndfile1 \
    libgomp1 \
    libgl1-mesa-glx \
    xz-utils wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

# FFmpeg statique avec NVENC + libx264 — build BtbN GPL (linux64)
# GPL inclut libx264 (fallback CPU si NVENC indisponible) + NVENC (GPU).
# Fetch dynamique du dernier autobuild — évite les URLs pinées périmées.
# Le nom d'asset BtbN a changé (ffmpeg-master-latest-* → ffmpeg-N-HASH-*)
# donc on interroge l'API GitHub pour trouver l'asset correct.
RUN FFMPEG_URL=$(python3 -c "import urllib.request,json; d=json.loads(urllib.request.urlopen('https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/latest',timeout=30).read()); print(next(a['browser_download_url'] for a in d['assets'] if a['name'].endswith('linux64-gpl.tar.xz') and 'shared' not in a['name'] and '-n7' not in a['name'].lower() and '-n8' not in a['name'].lower()))") \
    && FFMPEG_DIR=$(basename "$FFMPEG_URL" .tar.xz) \
    && wget -q "$FFMPEG_URL" \
    && tar -xf "${FFMPEG_DIR}.tar.xz" \
    && mv "${FFMPEG_DIR}/bin/ffmpeg" /usr/local/bin/ffmpeg \
    && mv "${FFMPEG_DIR}/bin/ffprobe" /usr/local/bin/ffprobe \
    && rm -rf "${FFMPEG_DIR}"* \
    && ffmpeg -version

WORKDIR /app

# Torch CUDA — layer séparée, rejouée uniquement si cette ligne change (pas si requirements-worker.txt change).
# cu128 = build PyTorch natif CUDA 12.8 (correspond à la base image).
# Installé AVANT whisperx pour imposer la variante CUDA correcte (whisperx tire torch en dep transitive).
#
# torchaudio : installé depuis le wheel CPU (download.pytorch.org/whl/cpu).
# torchaudio est utilisé par whisperx pour le resampling audio uniquement — pas d'inférence GPU.
# Le wheel CPU (~100 MB) remplace le wheel CUDA (~500 MB) sans perte fonctionnelle.
# IMPORTANT : la version torchaudio doit matcher torch. Si torch change de version, vérifier la cohérence.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir torchaudio --index-url https://download.pytorch.org/whl/cpu

# Dépendances Python minimales (sans Gradio)
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# ⚠️ Pre-bake des modèles AVANT COPY . . — ordre critique pour le cache Docker.
# Cette couche n'est rejouée que si requirements-worker.txt change.
# Changer le code Python (.py) ne relance PAS ce téléchargement.
# RunPod pull l'image une fois par machine (GRATUIT, hors billing GPU).
#
# large-v3 (~1.5 GB) N'est PAS baked ici : il est rarement sélectionné
# (option "Haute précision" manuelle). Le worker le télécharge au premier
# job qui le demande et le cache dans HF_HOME pour les jobs suivants sur
# la même instance. Si tu veux le pré-baker, ré-ajoute la ligne ci-dessous.
ENV HF_HOME=/app/hf_cache
RUN python -c "\
import whisperx; \
print('[build] downloading large-v3-turbo...', flush=True); \
whisperx.load_model('large-v3-turbo', 'cpu', compute_type='int8'); \
print('[build] downloading alignment model (fr)...', flush=True); \
whisperx.load_align_model(language_code='fr', device='cpu'); \
print('[build] models cached.', flush=True)"

# Code source — après les modèles pour ne pas invalider leur couche cache
COPY . .

# Dossier outputs temporaires
RUN mkdir -p outputs/temp/api

# Variables d'env
ENV PYTHONUNBUFFERED=1
ENV CAPTIONS_ENGINE=ass
# Expose les capacités GPU au container pour NVENC
ENV NVIDIA_VISIBLE_DEVICES=all
# "all" expose video+compute+utility+display+graphics → garantit l'accès NVENC sur tous les pods RunPod
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV PYTHONWARNINGS="ignore::UserWarning:pyannote"

CMD ["python", "-u", "runpod_worker.py"]
